QQMUSIC_APP_ID=YOUR_AUTHORIZED_APP_ID
QQMUSIC_APP_KEY=YOUR_AUTHORIZED_APP_KEY
QQMUSIC_AUTH_MODE=v2
QQMUSIC_GATEWAY=https://qplaycloud-quic.y.qq.com/rpc_proxy/fcgi-bin/music_open_api.fcg
QQMUSIC_PACKAGE_NAME=com.tencent.qqmusicpad
QQMUSIC_DEVICE_NAME=Fluent Music QQ plugin
# Optional: use a stable, authorized device identifier.
QQMUSIC_DEVICE_ID=
# Recommendation scene is supplied by the host SDK; 0 is a configurable initial choice, not a live-verified value.
QQMUSIC_RECOMMEND_SCENE=0
# Logged-in playlists use OpenQQMusic's homepage GET: type=0, need_songinfo=1.
# Missing/empty values also use 0 (compatible with older .env files); optional explicit overrides remain supported.
# No GetAlgorithmPlConf or native MER request is sent.
QQMUSIC_HOMEPAGE_TYPES=0
# Optional common device/version/channel JSON; path relative to plugin directory.
# Homepage-only defaults: cv=40071, bus_cv=6090007, device_id=UUID without hyphens.
# Explicit fields in this file take precedence; other API defaults are unchanged.
QQMUSIC_COMMON_PARAMS_FILE=
# Save authorized sessions encrypted with current-user Windows DPAPI (default: 1).
# 0 uses memory only (no automatic restore/save); explicit logout still deletes old saved credentials.
QQMUSIC_PERSIST_SESSION=1
# Optional private data directory; default is per-install under %LOCALAPPDATA%\FluentMusic\plugins\qqmusic.
# Keep the same directory across restarts; do not place it in a shared/synced folder.
QQMUSIC_DATA_DIR=
